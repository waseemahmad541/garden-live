generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  GARDENER
  CUSTOMER
  NURSERY_PARTNER
  LANDSCAPE_PARTNER
  FRANCHISE_PARTNER
}

enum AuthOtpPurpose {
  LOGIN
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AddressType {
  HOME
  WORK
  GARDEN
  BILLING
  SHIPPING
  OTHER
}

enum GardenType {
  BALCONY
  TERRACE
  HOME
  SOCIETY
  COMMERCIAL
  FARMHOUSE
  GOVERNMENT
  INSTITUTIONAL
}

enum GardenStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  ARCHIVED
}

enum PlantCategory {
  INDOOR
  OUTDOOR
  PALM
  FRUIT
  FLOWER
  HERB
  VEGETABLE
  TREE
  SUCCULENT
  ORNAMENTAL
  OTHER
}

enum HealthStatus {
  HEALTHY
  NEEDS_ATTENTION
  SICK
  CRITICAL
  DEAD
  REPLACED
}

enum TimelineSource {
  CUSTOMER
  GARDENER
  SUPERVISOR
  ADMIN
  AI
  SYSTEM
}

enum PlantTimelineType {
  PLANTED
  WATERED
  FERTILIZED
  PRUNED
  DIAGNOSED
  TREATED
  GROWTH_UPDATE
  WARRANTY_UPDATE
  REPLACEMENT_REQUESTED
  REPLACED
  NOTE
}

enum DiagnosisStatus {
  GENERATED
  REVIEWED
  ESCALATED
  CONSULTED
  ARCHIVED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MembershipBillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
  PENDING_PAYMENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentPurpose {
  MEMBERSHIP
  STORE_ORDER
  SERVICE_REQUEST
  GARDEN_PROJECT
  EXPERT_CONSULTATION
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  CASH
  BANK_TRANSFER
  UPI
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RETURN
  RESERVED
  RELEASED
}

enum ProjectStatus {
  ENQUIRY
  SITE_SURVEY
  QUOTATION
  APPROVED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum VisitStatus {
  SCHEDULED
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum ServiceRequestStatus {
  REQUESTED
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceRequestType {
  REGULAR_VISIT
  EMERGENCY
  PLANT_CARE
  PEST_CONTROL
  SOIL_CARE
  PRUNING
  INSTALLATION
  CONSULTATION
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum InsuranceStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ClaimStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REPLACED
  CANCELLED
}

enum QRCodeEntityType {
  PLANT
  GARDEN
  VISIT
  ORDER
  MEMBERSHIP
}

enum CoinTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTED
}

enum RewardType {
  GREEN_COINS
  COUPON
  DISCOUNT
  FREE_VISIT
  AI_CREDIT
}

enum CouponDiscountType {
  FLAT
  PERCENTAGE
}

enum NotificationType {
  SYSTEM
  AUTH
  PAYMENT
  MEMBERSHIP
  SERVICE
  PLANT_HEALTH
  ORDER
  REWARD
  CLAIM
  TENDER
  PROMOTION
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum TestReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  ACTION_REQUIRED
  ARCHIVED
}

enum TenderStatus {
  DRAFT
  SUBMITTED
  WON
  LOST
  CANCELLED
  WORK_ORDER_RECEIVED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum DocumentType {
  CONTRACT
  INVOICE
  QUOTATION
  TENDER
  WORK_ORDER
  REPORT
  INSURANCE
  ID_PROOF
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        RoleName   @unique
  description String?
  users       UserRole[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
  @@map("roles")
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  phone           String         @unique
  email           String?        @unique
  passwordHash    String?
  avatarUrl       String?
  status          UserStatus     @default(ACTIVE)
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  roles           UserRole[]
  authOtpCodes    AuthOtpCode[]
  authTokens      AuthToken[]
  customer        Customer?
  gardener        Gardener?
  supervisor      Supervisor?
  addresses       Address[]
  mediaFiles      MediaFile[]    @relation("MediaUploader")
  documents       Document[]     @relation("DocumentUploader")
  notifications   Notification[]
  activityLogs    ActivityLog[]  @relation("ActivityActor")
  payments        Payment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model AuthOtpCode {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String?        @db.Uuid
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String?
  email       String?
  codeHash    String
  purpose     AuthOtpPurpose
  attempts    Int            @default(0)
  maxAttempts Int            @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([phone, purpose])
  @@index([email, purpose])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("auth_otp_codes")
}

model AuthToken {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String           @unique
  purpose    AuthTokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  metadata   Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?

  @@index([userId, purpose])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("auth_tokens")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([deletedAt])
  @@map("user_roles")
}

model Customer {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @db.Uuid
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLanguage  String?
  referralCode       String?             @unique
  gardens            Garden[]
  plants             Plant[]
  activeMemberships  ActiveMembership[]
  orders             Order[]
  carts              Cart[]
  wishlists          Wishlist[]
  gardenProjects     GardenProject[]
  serviceRequests    ServiceRequest[]
  plantInsurance     PlantInsurance[]
  insuranceClaims    InsuranceClaim[]
  greenCoinAccount   GreenCoinAccount?
  rewards            Reward[]
  couponRedemptions  CouponRedemption[]
  aiDiagnoses        AIDiagnosis[]
  gardenHealthScores GardenHealthScore[]
  soilTestReports    SoilTestReport[]
  waterTestReports   WaterTestReport[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  @@index([referralCode])
  @@index([deletedAt])
  @@map("customers")
}

model Gardener {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @unique @db.Uuid
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode    String                @unique
  specialization  String?
  experienceYears Int?
  serviceCity     String?
  serviceArea     String?
  rating          Decimal?              @db.Decimal(3, 2)
  isAvailable     Boolean               @default(true)
  visits          GardenVisit[]
  attendance      Attendance[]
  schedules       MaintenanceSchedule[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  @@index([serviceCity, serviceArea])
  @@index([isAvailable])
  @@index([deletedAt])
  @@map("gardeners")
}

model Supervisor {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @unique @db.Uuid
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode    String                @unique
  region          String?
  managedCity     String?
  visits          GardenVisit[]
  projects        GardenProject[]
  schedules       MaintenanceSchedule[]
  insuranceClaims InsuranceClaim[]      @relation("ClaimReviewer")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  @@index([region, managedCity])
  @@index([deletedAt])
  @@map("supervisors")
}

model Address {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @db.Uuid
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      AddressType @default(HOME)
  name      String?
  phone     String?
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String      @default("India")
  latitude  Decimal?    @db.Decimal(10, 7)
  longitude Decimal?    @db.Decimal(10, 7)
  isDefault Boolean     @default(false)
  gardens   Garden[]
  orders    Order[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([city, state])
  @@index([pincode])
  @@index([deletedAt])
  @@map("addresses")
}

model Garden {
  id                   String                @id @default(uuid()) @db.Uuid
  customerId           String                @db.Uuid
  addressId            String?               @db.Uuid
  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  address              Address?              @relation(fields: [addressId], references: [id], onDelete: SetNull)
  name                 String
  type                 GardenType
  status               GardenStatus          @default(ACTIVE)
  areaSqft             Int?
  sunlightType         String?
  waterSource          String?
  notes                String?
  plants               Plant[]
  timelines            PlantTimeline[]
  healthScores         GardenHealthScore[]
  projects             GardenProject[]
  visits               GardenVisit[]
  serviceRequests      ServiceRequest[]
  maintenanceSchedules MaintenanceSchedule[]
  soilTestReports      SoilTestReport[]
  waterTestReports     WaterTestReport[]
  qrCodes              QRCode[]
  mediaFiles           MediaFile[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  @@index([customerId])
  @@index([addressId])
  @@index([type, status])
  @@index([deletedAt])
  @@map("gardens")
}

model Plant {
  id                  String           @id @default(uuid()) @db.Uuid
  gardenId            String           @db.Uuid
  customerId          String           @db.Uuid
  garden              Garden           @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  customer            Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name                String
  species             String?
  category            PlantCategory    @default(OTHER)
  healthStatus        HealthStatus     @default(HEALTHY)
  imageUrl            String?
  plantedAt           DateTime?
  lastCheckedAt       DateTime?
  replacementEligible Boolean          @default(false)
  careNotes           String?
  passport            PlantPassport?
  timelines           PlantTimeline[]
  aiDiagnoses         AIDiagnosis[]
  plantInsurance      PlantInsurance[]
  insuranceClaims     InsuranceClaim[]
  qrCodes             QRCode[]
  mediaFiles          MediaFile[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  @@index([gardenId])
  @@index([customerId])
  @@index([category])
  @@index([healthStatus])
  @@index([deletedAt])
  @@map("plants")
}

model PlantPassport {
  id                  String    @id @default(uuid()) @db.Uuid
  plantId             String    @unique @db.Uuid
  plant               Plant     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  passportCode        String    @unique
  qrCodeId            String?   @unique @db.Uuid
  qrCode              QRCode?   @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  origin              String?
  plantDetails        Json?
  careSchedule        Json?
  wateringFrequency   String?
  fertilizerFrequency String?
  sunlightRequirement String?
  warrantyStatus      String?
  warrantyStartDate   DateTime?
  warrantyEndDate     DateTime?
  lastServiceDate     DateTime?
  nextServiceDate     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([passportCode])
  @@index([deletedAt])
  @@map("plant_passports")
}

model PlantTimeline {
  id          String            @id @default(uuid()) @db.Uuid
  plantId     String            @db.Uuid
  gardenId    String?           @db.Uuid
  actorUserId String?           @db.Uuid
  plant       Plant             @relation(fields: [plantId], references: [id], onDelete: Cascade)
  garden      Garden?           @relation(fields: [gardenId], references: [id], onDelete: SetNull)
  type        PlantTimelineType
  source      TimelineSource    @default(SYSTEM)
  title       String
  notes       String?
  metadata    Json?
  mediaFiles  MediaFile[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  @@index([plantId, createdAt])
  @@index([gardenId])
  @@index([type])
  @@index([deletedAt])
  @@map("plant_timelines")
}

model AIDiagnosis {
  id                       String          @id @default(uuid()) @db.Uuid
  customerId               String          @db.Uuid
  plantId                  String?         @db.Uuid
  customer                 Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plant                    Plant?          @relation(fields: [plantId], references: [id], onDelete: SetNull)
  imageUrl                 String?
  symptomsText             String?
  diseaseDetection         Json?
  pestDetection            Json?
  healthScore              Int?
  waterRecommendation      String?
  fertilizerRecommendation String?
  medicineRecommendation   String?
  treatmentTimeline        Json?
  diagnosisSummary         String?
  severity                 Severity        @default(LOW)
  confidenceScore          Decimal?        @db.Decimal(5, 2)
  status                   DiagnosisStatus @default(GENERATED)
  recommendedProducts      Json?
  mediaFiles               MediaFile[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  deletedAt                DateTime?

  @@index([customerId])
  @@index([plantId])
  @@index([severity, status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("ai_diagnoses")
}

model GardenHealthScore {
  id                String    @id @default(uuid()) @db.Uuid
  gardenId          String    @db.Uuid
  customerId        String    @db.Uuid
  garden            Garden    @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  overallScore      Int
  plantHealthScore  Int?
  soilScore         Int?
  waterScore        Int?
  pestRiskScore     Int?
  maintenanceScore  Int?
  aiConfidenceScore Int?
  summary           String?
  recommendations   Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([gardenId, createdAt])
  @@index([customerId])
  @@index([overallScore])
  @@index([deletedAt])
  @@map("garden_health_scores")
}

model MembershipPlan {
  id                       String                 @id @default(uuid()) @db.Uuid
  name                     String
  slug                     String                 @unique
  description              String?
  price                    Decimal                @db.Decimal(12, 2)
  billingCycle             MembershipBillingCycle
  durationDays             Int
  visitCount               Int                    @default(0)
  plantCountLimit          Int?
  aiDoctorLimit            Int                    @default(0)
  replacementCoverageCount Int                    @default(0)
  storeDiscountPercentage  Decimal?               @db.Decimal(5, 2)
  rewardMultiplier         Decimal?               @db.Decimal(5, 2)
  features                 Json?
  isActive                 Boolean                @default(true)
  activeMemberships        ActiveMembership[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  deletedAt                DateTime?

  @@index([isActive])
  @@index([deletedAt])
  @@map("membership_plans")
}

model ActiveMembership {
  id                    String                @id @default(uuid()) @db.Uuid
  customerId            String                @db.Uuid
  planId                String                @db.Uuid
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan                  MembershipPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                MembershipStatus      @default(PENDING_PAYMENT)
  startDate             DateTime?
  endDate               DateTime?
  remainingVisits       Int                   @default(0)
  remainingAiCredits    Int                   @default(0)
  remainingReplacements Int                   @default(0)
  autoRenew             Boolean               @default(false)
  payments              Payment[]
  serviceRequests       ServiceRequest[]
  maintenanceSchedules  MaintenanceSchedule[]
  plantInsurance        PlantInsurance[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?

  @@index([customerId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
  @@index([deletedAt])
  @@map("active_memberships")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  name        String
  slug        String     @unique
  description String?
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([parentId])
  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  categoryId         String?             @db.Uuid
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name               String
  slug               String              @unique
  description        String?
  sku                String              @unique
  hsnCode            String?
  gstRate            Decimal?            @db.Decimal(5, 2)
  price              Decimal             @db.Decimal(12, 2)
  salePrice          Decimal?            @db.Decimal(12, 2)
  status             ProductStatus       @default(DRAFT)
  isAiRecommended    Boolean             @default(false)
  inventory          Inventory?
  orderItems         OrderItem[]
  cartItems          CartItem[]
  wishlists          Wishlist[]
  insuranceClaims    InsuranceClaim[]
  mediaFiles         MediaFile[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  @@index([categoryId])
  @@index([status])
  @@index([isAiRecommended])
  @@index([deletedAt])
  @@map("products")
}

model Inventory {
  id                String              @id @default(uuid()) @db.Uuid
  productId         String              @unique @db.Uuid
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockQuantity     Int                 @default(0)
  reservedQuantity  Int                 @default(0)
  lowStockThreshold Int                 @default(5)
  warehouseLocation String?
  movements         InventoryMovement[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  @@index([stockQuantity])
  @@index([deletedAt])
  @@map("inventory")
}

model InventoryMovement {
  id          String                @id @default(uuid()) @db.Uuid
  productId   String                @db.Uuid
  inventoryId String?               @db.Uuid
  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory   Inventory?            @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  type        InventoryMovementType
  quantity    Int
  reason      String?
  metadata    Json?
  createdById String?               @db.Uuid
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?

  @@index([productId])
  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("inventory_movements")
}

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String     @db.Uuid
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  @@index([customerId])
  @@index([deletedAt])
  @@map("carts")
}

model CartItem {
  id        String    @id @default(uuid()) @db.Uuid
  cartId    String    @db.Uuid
  productId String    @db.Uuid
  cart      Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([cartId, productId])
  @@index([productId])
  @@index([deletedAt])
  @@map("cart_items")
}

model Wishlist {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @db.Uuid
  productId  String    @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([customerId, productId])
  @@index([productId])
  @@index([deletedAt])
  @@map("wishlists")
}

model Order {
  id                String             @id @default(uuid()) @db.Uuid
  customerId        String             @db.Uuid
  shippingAddressId String?            @db.Uuid
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingAddress   Address?           @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  orderNumber       String             @unique
  status            OrderStatus        @default(PENDING)
  subtotal          Decimal            @db.Decimal(12, 2)
