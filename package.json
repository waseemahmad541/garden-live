{
  "name": "garden-live",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/with-root-env.cjs pnpm --filter @garden-live/web dev",
    "build": "node scripts/with-root-env.cjs pnpm --filter @garden-live/web build",
    "start": "node scripts/with-root-env.cjs pnpm --filter @garden-live/web start",
    "lint": "node scripts/with-root-env.cjs pnpm --filter @garden-live/web lint",
    "typecheck": "node scripts/with-root-env.cjs pnpm --filter @garden-live/web typecheck"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "prisma": {
    "schema": "packages/database/prisma/schema.prisma"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
