# Garden Live production environment template.
# Copy to .env.production and replace every CHANGE_ME value before deployment.

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_SITE_URL=https://gardenlive.in
DOMAIN_NAME=gardenlive.in
DOMAIN_ALIASES=www.gardenlive.in
LETSENCRYPT_EMAIL=admin@gardenlive.in

# PostgreSQL
POSTGRES_DB=garden_live
POSTGRES_USER=garden_live
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://garden_live:CHANGE_ME_STRONG_POSTGRES_PASSWORD@garden-live-postgres:5432/garden_live?schema=public

# Auth.js / NextAuth
AUTH_URL=https://gardenlive.in
AUTH_SECRET=CHANGE_ME_32_BYTE_RANDOM_SECRET
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# Cloudinary
CLOUDINARY_CLOUD_NAME=CHANGE_ME_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_ME_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=CHANGE_ME_CLOUDINARY_API_SECRET
CLOUDINARY_UPLOAD_PRESET=CHANGE_ME_SIGNED_UPLOAD_PRESET
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=CHANGE_ME_CLOUDINARY_CLOUD_NAME

# Razorpay live mode
RAZORPAY_KEY_ID=CHANGE_ME_RAZORPAY_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET

# Stripe live mode
STRIPE_SECRET_KEY=CHANGE_ME_STRIPE_LIVE_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=CHANGE_ME_STRIPE_LIVE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME_WHATSAPP_BUSINESS_ACCOUNT_ID
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_WHATSAPP_WEBHOOK_VERIFY_TOKEN

# Email
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM="Garden Live <care@gardenlive.in>"
EMAIL_SERVER=smtp://CHANGE_ME_SMTP_USER:CHANGE_ME_SMTP_PASSWORD@CHANGE_ME_SMTP_HOST:587
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY

# SMS
TWILIO_ACCOUNT_SID=CHANGE_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=CHANGE_ME_TWILIO_FROM_NUMBER
MSG91_AUTH_KEY=CHANGE_ME_MSG91_AUTH_KEY
MSG91_SENDER_ID=GARDEN

# Maps and analytics
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=CHANGE_ME_GOOGLE_MAPS_API_KEY
NEXT_PUBLIC_GA_MEASUREMENT_ID=CHANGE_ME_GA_MEASUREMENT_ID
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=CHANGE_ME_GOOGLE_SEARCH_CONSOLE_TOKEN

# AI Plant Doctor
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENAI_VISION_MODEL=gpt-4o-mini

# Operational settings
BACKUP_DIR=/backups/garden-live
RETENTION_DAYS=14
DISK_ALERT_PERCENT=85
ALERT_WEBHOOK_URL=
